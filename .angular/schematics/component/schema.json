{
  "$schema": "http://json-schema.org/schema",
  "id": "CustomComponent",
  "title": "Custom Angular Component",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The name of the component."
    },
    "path": {
      "type": "string",
      "description": "Path to create the component.",
      "default": "src/app"
    }
  },
  "required": ["name"]
}
